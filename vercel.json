{
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "ventexiq.com"
        }
      ],
      "dest": "/ventexiq.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "www.ventexiq.com"
        }
      ],
      "dest": "/ventexiq.html"
    },
    {
      "src": "/start/?",
      "dest": "/start.html"
    },
    {
      "src": "/demo/?",
      "dest": "/demo.html"
    },
    {
      "src": "/signup/?",
      "dest": "/signup.html"
    },
    {
      "src": "/ask/?",
      "dest": "/ask.html"
    },
    {
      "src": "/support/?",
      "dest": "/support.html"
    },
    {
      "src": "/book/?",
      "status": 308,
      "headers": {
        "Location": "/start#book"
      }
    },
    {
      "src": "/features/?",
      "dest": "/features.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}